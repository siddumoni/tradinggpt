# Copy this file to .env and fill in credentials from your Kite Connect app.
# Never commit .env or share its contents.
KITE_API_KEY=replace_with_your_api_key
KITE_API_SECRET=replace_with_your_api_secret

# Telegram notifications are optional and disabled unless explicitly enabled.
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
